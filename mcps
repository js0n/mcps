#!/usr/bin/env python3
"""List the MCP servers that Claude Code and Codex will load, by scope, across every project."""

import argparse
import json
import os
import shutil
import subprocess
import sys
import tomllib
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

__version__ = "0.1.0"

HOME = Path.home()

USAGE = """\
Scopes:
  global   every project        Claude ~/.claude.json, Codex ~/.codex/config.toml
  local    one folder, private  Claude ~/.claude.json, per project path
  project  shared in the repo   Claude .mcp.json, Codex .codex/config.toml

Projects are the folders Claude Code has opened, the projects Codex knows
about, the current folder, and every repo directly inside a --scan folder
(also read from MCPS_SCAN, colon-separated). Account connectors (claude.ai,
ChatGPT) and plugin servers are not stored in these files, so they are not
listed.

Repo-only servers:
  Claude Code shares a folder's local servers with git worktrees of that repo.
  Wrap a server's command in `mcps guard` to start it only in the repo itself:
    claude mcp add --scope local NAME -- mcps guard "$PWD" -- COMMAND [ARGS...]
"""


# --- Reading config ---------------------------------------------------------


def claude_config_path():
    base = os.environ.get("CLAUDE_CONFIG_DIR")
    if base:
        return Path(base) / ".claude.json"
    for path in (HOME / ".claude.json", HOME / ".claude" / ".claude.json"):
        if path.exists():
            return path
    return HOME / ".claude.json"


def codex_config_path():
    return Path(os.environ.get("CODEX_HOME", HOME / ".codex")) / "config.toml"


def read_json(path):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return {}


def read_toml(path):
    try:
        with open(path, "rb") as f:
            return tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError):
        return {}


def servers(table, tool, note=""):
    """Turn a {name: config} table into a list of server entries."""
    if not isinstance(table, dict):
        return []
    found = []
    for name, cfg in table.items():
        if not isinstance(cfg, dict):
            continue
        entry = {"tool": tool, "name": name, "note": note, **describe(cfg)}
        if cfg.get("enabled") is False:
            entry["note"] = join_notes(entry["note"], "disabled")
        found.append(entry)
    return found


def describe(cfg):
    """Transport, a short target and whether the server is wrapped in `mcps guard`."""
    if cfg.get("url"):
        url = cfg["url"].split("://", 1)[-1]
        return {"type": cfg.get("type", "http"), "target": url, "guarded": False}
    cmd = [str(cfg.get("command", ""))] + [str(a) for a in cfg.get("args", [])]
    guarded = Path(cmd[0]).name == "mcps" and cmd[1:2] == ["guard"] and "--" in cmd
    if guarded:
        cmd = cmd[cmd.index("--") + 1 :] or [""]
    cmd[0] = Path(cmd[0]).name if "/" in cmd[0] else cmd[0]
    return {"type": cfg.get("type", "stdio"), "target": " ".join(cmd), "guarded": guarded}


def join_notes(*notes):
    return ", ".join(n for n in notes if n)


def is_linked_worktree(path):
    # A linked worktree has a .git file; its repo files mirror the main checkout
    return (path / ".git").is_file()


def git_toplevel(cwd):
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            cwd=cwd, capture_output=True, text=True, check=True,
        )
        return out.stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return None


def scanned(roots):
    """Repos directly inside each root folder."""
    found = set()
    for root in roots:
        base = Path(root).expanduser()
        if base.is_dir():
            found |= {str(p) for p in base.iterdir() if (p / ".git").is_dir()}
    return found


def collect(scan=()):
    """Sections of servers: global first, then each folder."""
    claude = read_json(claude_config_path())
    codex = read_toml(codex_config_path())
    claude_projects = claude.get("projects", {}) or {}
    codex_projects = codex.get("projects", {}) or {}

    sections = [{
        "scope": "global",
        "dir": str(HOME),
        "servers": servers(claude.get("mcpServers"), "claude")
        + servers(codex.get("mcp_servers"), "codex"),
    }]

    for path, cfg in sorted(claude_projects.items()):
        found = servers((cfg or {}).get("mcpServers"), "claude")
        if found:
            sections.append({"scope": "local", "dir": path, "servers": found})

    folders = set(claude_projects) | set(codex_projects) | scanned(scan)
    here = git_toplevel(os.getcwd()) or os.getcwd()
    folders.add(here)
    for path in sorted(folders):
        folder = Path(path)
        if not folder.is_dir() or (is_linked_worktree(folder) and path != here):
            continue
        found = servers(read_json(folder / ".mcp.json").get("mcpServers"), "claude")
        codex_file = folder / ".codex" / "config.toml"
        if codex_file.exists():
            trusted = (codex_projects.get(path) or {}).get("trust_level") == "trusted"
            note = "" if trusted else "ignored: project not trusted"
            found += servers(read_toml(codex_file).get("mcp_servers"), "codex", note)
        if found:
            sections.append({"scope": "project", "dir": path, "servers": found})

    return [s for s in sections if s["servers"]]


# --- Health checks ----------------------------------------------------------


def claude_health(folder):
    """Ask Claude Code which servers connect in this folder: {name: state}."""
    try:
        out = subprocess.run(
            ["claude", "mcp", "list"], cwd=folder,
            capture_output=True, text=True, timeout=90,
        ).stdout
    except (OSError, subprocess.TimeoutExpired):
        return {}
    states = {}
    for line in out.splitlines():
        name, sep, rest = line.partition(": ")
        if not sep:
            continue
        if "✔" in rest:
            states[name] = "ok"
        elif "✘" in rest:
            states[name] = "failing"
        elif "⏸" in rest:
            states[name] = "needs approval"
    return states


def add_health(sections):
    if not shutil.which("claude"):
        return
    wanted = [s for s in sections if any(v["tool"] == "claude" for v in s["servers"])]
    with ThreadPoolExecutor(max_workers=8) as pool:
        results = pool.map(lambda s: claude_health(s["dir"]), wanted)
    for section, states in zip(wanted, results):
        for server in section["servers"]:
            if server["tool"] == "claude":
                server["status"] = states.get(server["name"], "unknown")


# --- Output -----------------------------------------------------------------


class Style:
    def __init__(self, enabled):
        def code(c):
            return f"\033[{c}m" if enabled else ""
        self.heading, self.name = code("1;34"), code("1;36")
        self.ok, self.bad, self.warn = code("32"), code("31"), code("33")
        self.reset = code("0")


def tilde(path):
    home = str(HOME)
    return "~" + path[len(home):] if path == home or path.startswith(home + "/") else path


def clip(text, width):
    return text if len(text) <= width else text[: max(width - 1, 0)] + "…"


def render(sections, status, style):
    subtitles = {"global": "every project", "local": "{dir}", "project": "{dir}  shared in the repo"}
    rows = [v for s in sections for v in s["servers"]]
    name_w = max((len(v["name"]) for v in rows), default=4)
    cols = shutil.get_terminal_size((100, 24)).columns
    target_w = max(cols - (2 + (2 if status else 0) + 8 + name_w + 1 + 6 + 1) - 28, 24)
    dots = {"ok": style.ok, "failing": style.bad, "needs approval": style.warn}

    lines = []
    for section in sections:
        sub = subtitles[section["scope"]].format(dir=tilde(section["dir"]))
        lines += ["", f"{style.heading}{section['scope'].upper()}{style.reset}  {sub}"]
        for v in section["servers"]:
            state = v.get("status")
            note = join_notes("repo only" if v["guarded"] else "", v["note"],
                              state if state in ("failing", "needs approval") else "")
            dot = ""
            if status:
                dot = f"{dots[state]}●{style.reset} " if state in dots else "○ "
            target = clip(v["target"], target_w)
            lines.append(
                f"  {dot}{v['tool']:<8}{style.name}{v['name']:<{name_w}}{style.reset} "
                f"{v['type']:<6} {target:<{target_w}}  {style.warn}{note}{style.reset}".rstrip()
            )
    return "\n".join(lines + [""])


# --- Guard ------------------------------------------------------------------


def guard(argv):
    """mcps guard ROOT -- COMMAND [ARGS...]: run COMMAND only inside the ROOT repo."""
    if len(argv) < 3 or argv[1] != "--":
        sys.exit("usage: mcps guard ROOT -- COMMAND [ARGS...]")
    root, command = argv[0], argv[2:]
    top = git_toplevel(os.getcwd())
    if top is None or os.path.realpath(top) != os.path.realpath(root):
        sys.exit(f"mcps guard: {command[0]} only runs in {root}")
    try:
        os.execvp(command[0], command)
    except OSError as err:
        sys.exit(f"mcps guard: {command[0]}: {err.strerror}")


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if argv[:1] == ["guard"]:
        guard(argv[1:])
        return

    parser = argparse.ArgumentParser(
        prog="mcps", description=__doc__, epilog=USAGE,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("-s", "--status", action="store_true",
                        help="check which Claude Code servers connect (a few seconds)")
    parser.add_argument("--scan", action="append", default=[], metavar="DIR",
                        help="also look at every repo directly inside DIR (repeatable)")
    parser.add_argument("--json", action="store_true", help="print JSON instead of a table")
    parser.add_argument("-V", "--version", action="version", version=f"mcps {__version__}")
    args = parser.parse_args(argv)

    env = [d for d in os.environ.get("MCPS_SCAN", "").split(":") if d]
    sections = collect(env + args.scan)
    if args.status:
        add_health(sections)
    if args.json:
        print(json.dumps(sections, indent=2))
        return
    color = sys.stdout.isatty() and "NO_COLOR" not in os.environ
    sys.stdout.write(render(sections, args.status, Style(color)))


if __name__ == "__main__":
    main()
